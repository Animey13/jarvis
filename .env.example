# JARVIS Environment Variables

# App Environment (development, production)
APP_ENV=development
APP_DEBUG=true

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# LLM Configuration (for future phases)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3:8b
# LLM_API_BASE=http://localhost:11434

# Speech Configuration (for future phases)
# SPEECH_INPUT_DEVICE=default
# SPEECH_TTS_PROVIDER=local
